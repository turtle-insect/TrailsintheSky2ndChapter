<Window x:Class="TrailsintheSky2ndChapter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrailsintheSky2ndChapter"
		xmlns:viewmodel="clr-namespace:TrailsintheSky2ndChapter.ViewModel"
        mc:Ignorable="d"
		WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="400" Width="600">
	<Window.DataContext>
		<viewmodel:MainViewModel/>
	</Window.DataContext>
	<DockPanel>
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="File">
				<MenuItem Header="Load" Command="{Binding LoadFileCommand}"/>
				<MenuItem Header="Save" Command="{Binding SaveFileCommand}"/>
			</MenuItem>
		</Menu>
		<TabControl>
			<TabItem Header="General">
				<Grid ColumnDefinitions="*, *, 5, *, *">
					<Grid.RowDefinitions>
						<RowDefinition/>
						<RowDefinition Height="11*"/>
					</Grid.RowDefinitions>
					<Label Content="Money"/>
					<TextBox Grid.Column="1" Text="{Binding General.Money, UpdateSourceTrigger=PropertyChanged}"/>
				</Grid>
			</TabItem>
		</TabControl>
	</DockPanel>
</Window>
